<resources>
    <string name="app_name">HelpCircle</string>
    <string name="accessibility_service_label">HelpCircle scroll monitor</string>
    <!-- Must stay in step with accessibilityEventTypes in xml/doomscroll_accessibility_service_config.xml.
         Taps are deliberately not observed, so this must not claim they are. -->
    <string name="accessibility_service_description">Watches the timing of scroll gestures on-device to detect doomscrolling patterns. It never reads screen content, and nothing it observes leaves the device.</string>
    <string name="monitoring_channel_name">Doomscroll monitoring</string>
    <string name="monitoring_channel_description">Silent, persistent notice that HelpCircle\'s scroll monitor is active.</string>
    <string name="monitoring_notification_text">HelpCircle is watching over you</string>
    <string name="nudge_channel_name">Nudges from your circle</string>
    <string name="nudge_channel_description">Alerts you when a community member sends you an intervention.</string>
    <string name="text_nudge_title">A message from your circle</string>
    <string name="haptic_nudge_title">Your circle reached out</string>
    <string name="haptic_nudge_text">Someone sent you a haptic nudge.</string>
    <string name="recovery_action_label">I\'m back</string>

    <!-- Peer crisis alerts. Kept on their own channel so a user can silence these without also
         silencing the interventions people send them, which are a different kind of interruption. -->
    <string name="peer_alert_channel_name">A peer needs support</string>
    <string name="peer_alert_channel_description">Alerts you when someone in your circle is struggling.</string>
    <string name="peer_crisis_title">%1$s needs support</string>
    <string name="peer_crisis_text">They\'re caught in a scroll right now. Tap to send them something.</string>
    <string name="peer_crisis_unknown_nickname">Someone in your circle</string>
    <string name="grayscale_nudge_title">Your circle reached out</string>
    <string name="grayscale_nudge_text">Someone sent you a grey-scale nudge, but this device can\'t dim the screen right now.</string>
    <string name="content_blur_nudge_title">Your circle reached out</string>
    <string name="content_blur_nudge_text">Someone sent you a content-blur nudge, but this device can\'t blur the screen right now.</string>
</resources>
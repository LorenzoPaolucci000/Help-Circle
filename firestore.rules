rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /communities/{communityId} {
      // The IA_comm aggregate and member roster are visible to any signed-in (anonymous) user.
      allow read: if request.auth != null;

      // Only activeMembers/lastActivity are client-writable; IA_comm is set only server-side,
      // per the Mathematical Inflation guideline — clients must never self-report their score.
      // inviteCode may only be set at creation (matching InviteCodeGenerator's shape) and is
      // immutable afterward — the update rule below never includes it in its allowed keys.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['activeMembers', 'lastActivity', 'inviteCode'])
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.matches('^[A-Z0-9]{6}$');
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeMembers', 'lastActivity']);
      allow delete: if false;

      match /members/{memberId} {
        // Readable only by fellow members of this same community (callers who already have
        // their own roster entry here) — never by the public at large.
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));

        // A member may only ever write their own entry, and only nickname/status/agencyScore/
        // satisfaction/satisfactionWeekStart/lastSeen — never anything else, per the Zero-PII
        // rule. agencyScore is a derived 0-100 IA_ind value, not behavioral data, and satisfaction
        // is a self-declared weekly mood rating, so sharing either doesn't violate Zero-PII.
        //
        // Every field is optional here rather than required: this document is built up by two
        // independent merge writes (the roster fields, and the satisfaction rating), so either can
        // legitimately land on its own. Each field is therefore validated only when present.
        allow create, update: if request.auth != null
          && request.auth.uid == memberId
          && request.resource.data.keys().hasOnly(
               ['nickname', 'status', 'agencyScore', 'satisfaction', 'satisfactionWeekStart', 'lastSeen'])
          && (!('nickname' in request.resource.data.keys())
               || (request.resource.data.nickname is string
                   && request.resource.data.nickname.size() <= 20))
          && (!('status' in request.resource.data.keys())
               || request.resource.data.status in ['ok', 'at_risk', 'crisis'])
          && (!('agencyScore' in request.resource.data.keys())
               || (request.resource.data.agencyScore is int
                   && request.resource.data.agencyScore >= 0
                   && request.resource.data.agencyScore <= 100))
          && (!('satisfaction' in request.resource.data.keys())
               || request.resource.data.satisfaction in ['bad', 'neutral', 'happy'])
          && (!('satisfactionWeekStart' in request.resource.data.keys())
               || request.resource.data.satisfactionWeekStart is int);

        // Leaving a community removes only the caller's own roster entry.
        allow delete: if request.auth != null && request.auth.uid == memberId;
      }

      match /events/{eventId} {
        // Events are append-only and always self-attributed; never directly readable, updatable
        // or deletable — incoming nudges are read only via the collection-group rule below.
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.communityId == communityId
          && request.resource.data.type in ['crisis_alert', 'recovery_reported', 'nudge_sent'];
        allow read, update, delete: if false;
      }
    }

    // NudgeRepositoryImpl.incomingNudges runs a collectionGroup("events") query across every
    // community; this is the rule Firestore checks for that query shape (distinct from the
    // nested /communities/{id}/events rule above, which only governs the direct-path create).
    // Only nudge_sent events addressed to the caller are ever readable this way.
    match /{path=**}/events/{eventId} {
      allow read: if request.auth != null
        && resource.data.type == 'nudge_sent'
        && resource.data.targetId == request.auth.uid;
    }
  }
}
